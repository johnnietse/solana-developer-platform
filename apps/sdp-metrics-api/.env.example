# Parquet table on S3 that backs GET /data. Glob to match every part-file.
S3_PARQUET_PATH=s3://tmp-sdp-data/dev/mlh/**/*.parquet

# AWS region of the bucket above.
AWS_REGION=us-east-1

# Local-only. Leave unset to use the default AWS credential chain
# (aws configure / instance role). Never set these in ECS — the task role
# is used there instead.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# ─── GET /rpc ────────────────────────────────────────────────────────────────
# Delta table the /rpc cache reads and writes. Deliberately not dev.mlh.rpc —
# that path holds the retired per-signature table with a different schema.
RPC_TABLE_NAME=dev.mlh.rpc_counts
# Bucket the dotted table name above is resolved against.
S3_INSERT_BUCKET=tmp-sdp-data
# How long a cached count stays fresh, in seconds.
RPC_CACHE_TTL_SECONDS=3600
# Default RPC when no ?cluster= is given.
SOLANA_RPC_URL=https://api.devnet.solana.com

PORT=8080
